# Copy this file to .env before running the server.
# All server-side configuration belongs here — never in the client/ folder.

NODE_ENV=development
PORT=5000

# Real upstream NHA HRIS API.
HRIS_API_BASE_URL=https://ettm.nha.gov.pk/hris_ci/
HRIS_API_TIMEOUT_MS=30000

# NOTE: No API key is needed. Login is open (username/password only) and every
# other route is authenticated by the user's own JWT, which the proxy forwards
# from the browser in the Authorization header.

# Restrict CORS to the local frontend during development.
CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
