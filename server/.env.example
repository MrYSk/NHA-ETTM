# Copy this file to .env before running the server in real-API mode.
# All secrets belong here — never in the client/ folder or in git history.

NODE_ENV=development
PORT=5000

# Real upstream NHA HRIS API.
HRIS_API_BASE_URL=https://ettm.nha.gov.pk/hris_ci/
HRIS_API_TIMEOUT_MS=15000

# TODO: Confirm with the backend team whether the upstream API requires an
# API key/bearer token, and if so, set it here. Leave blank if not required.
HRIS_API_KEY=

# Restrict CORS to the local frontend during development.
CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
