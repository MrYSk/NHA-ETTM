# Copy this file to .env and adjust values as needed.
# The client never talks directly to https://ettm.nha.gov.pk/hris_ci/ —
# it always calls the local Node proxy at VITE_APP_API_BASE_URL.

# Same-origin path the frontend calls; Vite proxies this to the backend in dev.
VITE_APP_API_BASE_URL=/api

# When true, all data comes from the in-memory mock layer — no backend or
# network connection required. Set to false to use the real API through the
# Node proxy (requires server/.env to be configured with real credentials).
VITE_USE_MOCK_API=true
