# Copy this file to .env and adjust values as needed.
# The client never talks directly to https://ettm.nha.gov.pk/hris_ci/ —
# it always calls the local Node proxy at VITE_APP_API_BASE_URL, which attaches
# the server-side X-API-KEY. There is no mock/demo mode.

# Same-origin path the frontend calls; Vite proxies this to the backend in dev.
VITE_APP_API_BASE_URL=/api
